{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack -p 3001",
    "build": "next build",
    "start": "next start -p 3001",
    "lint": "eslint",
    "seed": "tsx --env-file=.env.local scripts/seed.ts",
    "backup:db": "tsx --env-file=.env.local scripts/backup-db.ts",
    "smoke": "node --env-file=.env.local scripts/smoke-api.mjs",
    "accept": "node --env-file=.env.local scripts/launch-acceptance.mjs",
    "test": "vitest run --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "cf:build": "node scripts/cf-with-neon-env.mjs build",
    "cf:preview": "node scripts/cf-with-neon-env.mjs preview",
    "cf:deploy": "node scripts/cf-with-neon-env.mjs deploy",
    "cf:setup-r2": "node scripts/setup-cloudflare-r2.mjs",
    "cf:typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1164.0",
    "@electric-sql/pglite": "^0.5.15",
    "@neondatabase/serverless": "^1.2.0",
    "@opennextjs/cloudflare": "^1.20.16",
    "@tiptap/extension-image": "^3.33.0",
    "@tiptap/extension-link": "^3.33.0",
    "@tiptap/extension-placeholder": "^3.33.0",
    "@tiptap/extension-underline": "^3.33.0",
    "@tiptap/pm": "^3.33.0",
    "@tiptap/react": "^3.33.0",
    "@tiptap/starter-kit": "^3.33.0",
    "bcryptjs": "^3.0.3",
    "drizzle-orm": "^0.45.4",
    "isomorphic-dompurify": "^3.19.0",
    "jose": "^6.2.15",
    "jsdom": "^29.1.1",
    "motion": "^14.10.1",
    "next": "^16.4.5",
    "postgres": "^4.1.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "simple-icons": "^16.36.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@types/bcryptjs": "^2.4.6",
    "@types/dompurify": "^3.0.5",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "15.5.4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^3.2.4",
    "wrangler": "^4.158.0"
  }
}
