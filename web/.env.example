# Copy to .env.local for local development only.
# Never commit real secrets. Never use production credentials here.

AUTH_SECRET=replace-with-a-long-random-string-at-least-32-chars
ADMIN_BOOTSTRAP_EMAIL=admin@zaincodes.local
ADMIN_BOOTSTRAP_PASSWORD=replace-with-a-long-local-only-password
PGLITE_DATA_DIR=.data/pglite
PORTFOLIO_JSON_PATH=../src/data/portfolioData.json
STORAGE_DRIVER=local
SEED_MODE=upsert
NEXT_PUBLIC_SITE_URL=http://localhost:3001

# Google Search Console + GA4 (optional — leave unset = disconnected in admin)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GSC_SITE_URL=https://www.example.com/
# GA4_PROPERTY_ID=properties/000000000

# --- Production durability (required before live launch) ---
# Cloudflare Workers deploy: npm run cf:deploy (after wrangler login)
# Free-tier options (owner must create accounts; not activated by this repo):
# - Neon / Supabase Postgres free tier → DATABASE_URL (required on Cloudflare; PGlite is local-only)
# - Cloudflare R2 → STORAGE_DRIVER=r2 + S3_* keys (npm run cf:setup-r2 after wrangler login)
#
# When DATABASE_URL is set, PGlite is NOT used.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require
#
# Cloudflare R2 object storage (blog images, project media, resume):
# STORAGE_DRIVER=r2
# S3_BUCKET=zaincodes-media
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_ENDPOINT=https://ACCOUNTID.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_PUBLIC_URL=https://media.example.com
#
# Local Docker Postgres (optional):
# DATABASE_URL=postgresql://zaincodes:zaincodes_local@localhost:5433/zaincodes_dev
